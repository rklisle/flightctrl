# 方案一：白名单模式（只允许特定文件）
# 忽略所有文件
*

# 但允许以下类型的文件
!*.c
!*.h
!*.cpp
!*.hpp
!*.s
!*.asm
!*.md

# 允许目录（空目录会被保留）
!*/

# 允许.gitignore本身
!.gitignore

# 允许特定的配置文件
# !Makefile
# !*.mk
# ====== Keil工程文件例外 ======
# 允许Keil工程文件
!*.uvprojx
!*.uvoptx

# 但忽略用户特定的配置（包含用户名）
*.uvguix.*

# ====== 编译输出目录完全忽略 ======
# 这些目录应该被完全忽略，即使有c/h文件
env/keil/Output/
env/keil/Listings/

# ====== 其他编译文件 ======
# 忽略常见的编译输出文件
*.o
*.d
*.su
*.bin
*.elf
*.hex
*.map
*.dep
*.build_log.*
*.lst
